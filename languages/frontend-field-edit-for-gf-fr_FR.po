msgstr "Description"

msgid "Descriptions must be 2000 characters or fewer."
msgstr "Les descriptions doivent contenir 2000 caractères ou moins."

msgid "Disable"
msgstr "Désactiver"

msgid "Disabled"
msgstr "Désactivé"

msgid "Disabled is the safer default for live sites; individual forms can opt in later."
msgstr "Désactivé est l'option la plus sûre par défaut pour les sites en production ; les formulaires individuels pourront l'activer plus tard."

msgid "Drop Down"
msgstr "Liste déroulante"

msgid "Duplicate Address field inputs were submitted."
msgstr "Des entrées de champ Adresse dupliquées ont été envoyées."

msgid "Duplicate Address field default value inputs were submitted."
msgstr "Des entrées de valeur par défaut du champ Adresse en double ont été envoyées."

