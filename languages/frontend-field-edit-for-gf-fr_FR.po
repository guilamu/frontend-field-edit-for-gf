msgstr "Édition de champ en frontal"

msgid "Frontend Field Edit for Gravity Forms"
msgstr "Frontend Field Edit for Gravity Forms"

msgid "General"
msgstr "Général"

msgid "Grant dedicated capability to roles"
msgstr "Accorder la capacité dédiée aux rôles"

msgid "Inactive"
msgstr "Inactif"

msgid "Inherit"
msgstr "Hériter"

msgid "Label"
msgstr "Libellé"

msgid "Labels must be 500 characters or fewer."
msgstr "Les libellés doivent contenir 500 caractères ou moins."

msgid "Missing field information for this edit request."
msgstr "Informations de champ manquantes pour cette demande de modification."

msgid "Missing form or setting information."
msgstr "Informations de formulaire ou de réglage manquantes."

msgid "More information about Frontend Field Edit for Gravity Forms"
msgstr "Plus d'informations sur Frontend Field Edit for Gravity Forms"

msgid "Multiple Choice"
msgstr "Choix multiple"

msgid "Name"
msgstr "Nom"

msgid "Name field custom sub-labels must be 500 characters or fewer."
msgstr "Les sous-libellés personnalisés des champs Nom doivent contenir 500 caractères ou moins."

msgid "Name Fields"
msgstr "Champs Nom"

msgid "Name fields could not be saved because the request payload was invalid."
msgstr "Les champs Nom n'ont pas pu être enregistrés car la charge utile de la requête était invalide."

msgid "Next"
msgstr "Suivant"

msgid "Next field (CTRL+→)"
msgstr "Champ suivant (CTRL+→)"

msgid "Number"
msgstr "Nombre"

msgid "Number fields require a numeric default value."
msgstr "Les champs Nombre nécessitent une valeur par défaut numérique."

msgid "One of the Address field default value inputs was not recognized."
msgstr "L'une des entrées de valeur par défaut du champ Adresse n'a pas été reconnue."

msgid "One of the Address field inputs was not recognized."
msgstr "L'une des entrées du champ Adresse n'a pas été reconnue."

msgid "One of the Name field inputs was not recognized."
msgstr "L'une des entrées du champ Nom n'a pas été reconnue."

msgid "One of the Time field inputs was not recognized."
msgstr "L'une des entrées du champ Heure n'a pas été reconnue."

msgid "One of the Time field default value inputs was not recognized."
msgstr "L'une des entrées de valeur par défaut du champ Heure n'a pas été reconnue."

msgid "Only supported options for this field type are shown here. Global plugin settings can still restrict what appears on the frontend."
msgstr "Seules les options prises en charge pour ce type de champ sont affichées ici. Les réglages globaux de l'extension peuvent encore restreindre ce qui apparaît en frontal."

msgid "Paragraph Text"
msgstr "Texte de paragraphe"

msgid "Permissions"
msgstr "Autorisations"

msgid "Phone"
msgstr "Téléphone"

msgid "Placeholder"
msgstr "Texte indicatif"

msgid "Placeholders must be 200 characters or fewer."
msgstr "Les textes indicatifs doivent contenir 200 caractères ou moins."

msgid "Address field default values could not be saved because the request payload was invalid."
msgstr "Les valeurs par défaut du champ d'adresse n'ont pas pu être enregistrées car la charge utile de la requête était invalide."

msgid "Address field default values must be 500 characters or fewer."
msgstr "Les valeurs par défaut du champ d'adresse doivent contenir 500 caractères ou moins."

msgid "Default countries must be 200 characters or fewer."
msgstr "Les pays par défaut doivent contenir 200 caractères ou moins."

msgid "Previous"
msgstr "Précédent"

msgid "Previous field (CTRL+←)"
msgstr "Champ précédent (CTRL+←)"

msgid "Radio Buttons"
msgstr "Boutons radio"

msgid "Report a Bug"
msgstr "Signaler un bug"

