msgstr "Activer l'édition de champ en frontal"

msgid "Enable frontend field editing on this form"
msgstr "Activer l'édition de champs en frontal sur ce formulaire"

msgid "Enable on new forms by default"
msgstr "Activer par défaut sur les nouveaux formulaires"

